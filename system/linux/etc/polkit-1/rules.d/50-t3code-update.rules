// Let chus start t3code-update.service without a password. That service can
// only install the latest t3code-nightly-bin from the AUR.
polkit.addRule(function (action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" &&
      action.lookup("unit") == "t3code-update.service" &&
      action.lookup("verb") == "start" &&
      subject.user == "chus") {
    return polkit.Result.YES;
  }
});
